# Copy to deploy/host-baseline.env (which is ignored) and fill every value.
# Do not put a token, private key, or runtime secret in this example.
HETZNER_TOKEN=
SERVER_NAME=
HETZNER_SSH_KEY_NAME=
SSH_PUBLIC_KEY=
ADMIN_SSH_PRIVATE_KEY=
# Comma-separated IPv4 or IPv6 CIDRs permitted to administer the host.
SSH_ALLOWED_CIDRS=
# The dedicated non-root administrator created during bootstrap.
ADMIN_USER=mawareeth-admin
# Optional; defaults to "${SERVER_NAME}-edge" when omitted.
FIREWALL_NAME=
