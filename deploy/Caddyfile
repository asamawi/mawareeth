{
	# Deliberate decision (story 0.6): the admin API listens only on the
	# container loopback so `caddy reload` can apply route switches. Port 2019
	# is never published; only TCP 80/443 leave the container.
	admin localhost:2019
	# Edge mode (EDGE_MODE in runtime.env, validated by deploy/runtime.sh):
	# acme (default) adds nothing; cloudflare disables certificate automation
	# and trusts forwarded headers only from Cloudflare's ranges.
	import /etc/caddy/edge/{$EDGE_MODE:acme}/global.caddy
}

{$DOMAIN:unprepared.invalid} {
	# cloudflare: load the Origin CA certificate instead of using ACME.
	import /etc/caddy/edge/{$EDGE_MODE:acme}/site.caddy
	encode zstd gzip
	# Deliberate decision: release identity (version and commit) is never
	# served through the edge. Caddy answers 404 to every client without
	# contacting the app. No source-address exception: with Docker IPv6 off,
	# IPv6 clients arrive through docker-proxy as the private bridge gateway,
	# so an address check cannot tell them from local callers. The deploy reads
	# the commit by probing the slot directly and proves the routed slot from
	# the X-Mawareeth-Slot header on /health/ready/. /health/live/ and
	# /health/ready/ stay public for external monitors. respond sorts before
	# reverse_proxy in Caddy's directive order. Caddy also replaces client
	# X-Forwarded-* headers unless the connection comes from a trusted proxy;
	# only the cloudflare edge mode trusts any (Cloudflare's ranges), and the
	# route never forwards them itself (Django trusts X-Forwarded-Proto only
	# from Caddy).
	respond /health/release* 404
	import /etc/caddy/routes/*.caddy
}

# cloudflare: the REDIRECT_DOMAIN site that redirects to DOMAIN.
import /etc/caddy/edge/{$EDGE_MODE:acme}/sites.caddy

http://127.0.0.1 {
	respond /health/caddy 200
}
