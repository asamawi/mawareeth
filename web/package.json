{
  "name": "mawareeth-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prune-export.mjs",
    "lint": "eslint",
    "i18n": "node --import ./src/test/loader.mjs scripts/i18n.mjs",
    "i18n:write": "node --import ./src/test/loader.mjs scripts/i18n.mjs --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:live": "node e2e-live/run.mjs",
    "test": "node --import ./src/test/loader.mjs --test \"src/**/*.test.{ts,tsx}\""
  },
  "dependencies": {
    "@types/uuid": "10.0.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "happy-dom": "21.0.4",
    "sucrase": "3.35.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
