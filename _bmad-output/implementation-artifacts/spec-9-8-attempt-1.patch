+def _trimmed(case):
+    """A copy of the case without its pending deaths, so each is an ordinary first-estate heir."""
+    kept = [d for d in sorted(case.get('deaths', []), key=lambda d: d['order']) if d['heirs']]
+    if len(kept) == len(case.get('deaths', [])):
+        return case
+    return {**case, 'deaths': [{**d, 'order': i} for i, d in enumerate(kept, 2)]}
 
 
